# Inverted / whitelist gitignore: ignore everything, then un-ignore what ships.
# https://git-scm.com/docs/gitignore — negation rules; parent dirs must be un-ignored
# so git can descend (e.g. !.cursor/ then !.cursor/rules/**).

*

# --- Root ---
!.gitignore
!/README.md
!/CONTRIBUTING.md
!/package.json

# --- Scripts ---
!/scripts/
!/scripts/**

# --- Rhai distill scripts (orchestration; no transcript data) ---
!/rhai/
!/rhai/**

# --- Thin Rhai host (source only; target/ stays ignored) ---
!/tools/
!/tools/rhai-host/
!/tools/rhai-host/Cargo.toml
!/tools/rhai-host/Cargo.lock
!/tools/rhai-host/src/
!/tools/rhai-host/src/**
/tools/rhai-host/target/

# --- Docs + artifact templates ---
!/docs/
!/docs/**
# Host-specific discovery notes (keep local)
/docs/**/*.local.md

# --- Cursor project config ---
!/.cursor/
!/.cursor/**

# --- data/: only scaffolding (manifest, raw, splits, drafts, zips stay ignored) ---
!/data/
!/data/bundle-targets.example.json
!/data/backups/
!/data/backups/README.md
!/data/raw/
!/data/raw/.gitkeep
!/data/raw/manual/
!/data/raw/manual/.gitkeep
!/data/processed/
!/data/processed/.gitkeep
!/data/splits/
!/data/splits/.gitkeep
!/data/artifact-drafts/
!/data/artifact-drafts/.gitkeep
# distill run outputs (session insights, aggregates, drafts) — local only
/data/distill/
